<a class="back" href="./">← All episodes</a>
<h1 data-pagefind-sort="episode_number:<%= ep.fetch(:number) %>"><%= CGI.escapeHTML("#{ep.fetch(:number)}. #{ep.fetch(:title)}") %></h1>

<% unless entities.empty? %>
<details class="entities" data-pagefind-ignore>
  <summary><%= entities.size %> topics</summary>
  <% entities.group_by(&:type).sort.each do |type, es| %>
    <p><span class="kind"><%= type %>:</span>
    <% es.each.with_index do |e, i| %><%= ", " unless i.zero? %><a href="entities/<%= e.slug %>.html"><%= CGI.escapeHTML(e.name) %></a><% end %></p>
  <% end %>
</details>
<% end %>

<% ep.fetch(:text).split("\n\n").each do |para| %>
  <% if (m = para.match(/\A\[([^\]]+)\]\s*(.*)/)) %>
    <% anchor = CookingIssues::Timestamp.anchor(m[1]) %>
    <% time = CookingIssues::Timestamp.clean(m[1]) %>
    <h6 id="<%= anchor %>" class="timestamp"><a href="#<%= anchor %>" data-seek="<%= time %>">[<%= CGI.escapeHTML(m[1]) %>]</a></h6>
    <p><%= CGI.escapeHTML(m[2]) %></p>
  <% else %>
    <p><%= CGI.escapeHTML(para) %></p>
  <% end %>
<% end %>
