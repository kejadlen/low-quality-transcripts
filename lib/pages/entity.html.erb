<a class="back" href="index.html">← All topics</a>
<h1><%= CGI.escapeHTML(entity.name) %></h1>
<p class="kind"><%= entity.type %> · <%= episodes.size %> episodes</p>

<h2>Episodes</h2>
<ul class="mentions">
<% episodes.each do |ep| %>
  <li>
    <a href="../<%= ep.fetch(:slug) %>.html"><%= CGI.escapeHTML("#{ep.fetch(:number)}. #{ep.fetch(:title)}") %></a>
    <span class="ts">
    <% ep.fetch(:snippets).each do |ts, excerpt| %>
      <% id = "s-#{ep.fetch(:number)}-#{CookingIssues::Timestamp.anchor(ts)}" %>
      <button type="button" popovertarget="<%= id %>"><%= CGI.escapeHTML(ts) %></button>
      <div class="snippet" id="<%= id %>" popover>
        <p class="kind"><%= CGI.escapeHTML("#{ep.fetch(:number)}. #{ep.fetch(:title)}") %> · <%= CGI.escapeHTML(ts) %></p>
        <blockquote><%= CGI.escapeHTML(excerpt.before) %><% unless excerpt.match.empty? %><mark><%= CGI.escapeHTML(excerpt.match) %></mark><% end %><%= CGI.escapeHTML(excerpt.after) %></blockquote>
        <a href="../<%= ep.fetch(:slug) %>.html#<%= CookingIssues::Timestamp.anchor(ts) %>">Open in transcript →</a>
      </div>
    <% end %>
    </span>
  </li>
<% end %>
</ul>

<% unless related.empty? %>
<h2>Often discussed with</h2>
<ul class="related">
<% related.each do |r| %>
  <li><a href="<%= r.entity.slug %>.html"><%= CGI.escapeHTML(r.entity.name) %></a> <span class="kind"><%= r.entity.type %> · <%= r.shared %> shared</span></li>
<% end %>
</ul>
<% end %>
