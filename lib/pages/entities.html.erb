<a class="back" href="../">← All episodes</a>
<h1>Topics</h1>
<p class="kind">People, techniques, ingredients, equipment, and places, extracted automatically, so expect noise. Each section lists topics from <%= featured_min %> or more episodes; the rest are folded underneath.</p>

<% by_type.each do |type, entities| %>
<% featured, minor = entities.partition { it.episodes.size >= featured_min } %>
<section>
<h2 id="<%= type %>"><%= type.capitalize %></h2>
<% if featured.any? %>
<ul class="topics">
<% featured.each do |e| %>
  <li><a href="<%= e.slug %>.html"><%= CGI.escapeHTML(e.name) %></a> <span class="kind"><%= e.episodes.size %></span></li>
<% end %>
</ul>
<% end %>
<% if minor.any? %>
<details class="more">
<summary><%= featured.any? ? "#{minor.size} more" : "Show #{minor.size}" %></summary>
<p class="more-list"><%= minor.sort_by { it.name.downcase }.map { %(<a href="#{it.slug}.html">#{CGI.escapeHTML(it.name)}</a>) }.join(" · ") %></p>
</details>
<% end %>
</section>
<% end %>
