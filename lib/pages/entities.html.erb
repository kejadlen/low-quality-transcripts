<a class="back" href="../">← All episodes</a>
<h1>Topics</h1>
<p class="kind">People, techniques, ingredients, equipment, and places mentioned in at least <%= min_episodes %> episodes. Extracted automatically, so expect noise.</p>

<% by_type.each do |type, entities| %>
<h2 id="<%= type %>"><%= type.capitalize %></h2>
<ul class="topics">
<% entities.each do |e| %>
  <li><a href="<%= e.slug %>.html"><%= CGI.escapeHTML(e.name) %></a> <span class="kind"><%= e.episodes.size %></span></li>
<% end %>
</ul>
<% end %>
